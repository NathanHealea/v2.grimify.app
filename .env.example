# Copy to .env.local and fill in. Everything prefixed VITE_ is public (shipped to the browser).
# See docs/ENVIRONMENT.md.

# Written by `npx convex dev`
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Clerk development instance: dashboard → API keys (pk_test_…)
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk Frontend API URL (dashboard → Integrations → Convex). Also set on the Convex deployment:
# npx convex env set CLERK_JWT_ISSUER_DOMAIN <url>
CLERK_JWT_ISSUER_DOMAIN=
